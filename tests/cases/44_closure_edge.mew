# closure edge cases: parameter shadowing, env chain semantics, late binding.

# outer x is captured; inner fn param x shadows
fn makeInc(x)
    return fn(y) return x + y end
end
add5 = makeInc(5)
add10 = makeInc(10)
print(add5(3))          # 8
print(add10(3))         # 13

# mutating captured variable via nested assignment
fn make_counter()
    n = 0
    return fn()
        n = n + 1
        return n
    end
end
c = make_counter()
print(c())              # 1
print(c())              # 2
print(c())              # 3

# two independent counters do not share state
d = make_counter()
print(d())              # 1 again
print(c())              # 4 (c advances independently)

# parameter name equal to outer variable: binding takes precedence inside
x = 100
fn shadow(x) return x * 2 end
print(shadow(5))        # 10
print(x)                # still 100
