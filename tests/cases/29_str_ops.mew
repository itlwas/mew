print(trim("   hello world   "))
print(repeat("ab", 3))
print(repeat("x", 0))
print(starts_with("mewmeow", "mew"))
print(starts_with("mew", "meow"))
print(ends_with("hello.mew", ".mew"))
print(ends_with("hello", ".mew"))
print(contains("banana", "nan"))
print(contains("hello", "xyz"))
print(contains([1, 2, 3], 2))
print(contains([1, 2, 3], 4))
print(contains({"a":1, "b":2}, "a"))
print(contains({"a":1, "b":2}, "c"))
print(reverse([1, 2, 3]))
print(reverse("mew"))
