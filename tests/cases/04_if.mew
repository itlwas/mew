x = 5
if x > 0 then
    print("positive")
else
    print("non-positive")
end

if x > 100 then
    print("big")
else
    if x > 3 then
        print("medium")
    else
        print("small")
    end
end

# truthy values
if 0 then print("zero true") end
if "" then print("empty true") end
if nil then print("nil true") else print("nil false") end
if false then print("false true") else print("false false") end
