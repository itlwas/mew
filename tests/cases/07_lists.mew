xs = [1, 2, 3, 4, 5]
print(len(xs))
print(xs[0])
print(xs[4])
print(xs[-1])

# mutation
xs[0] = 10
print(xs)

push(xs, 99)
print(xs)
print(pop(xs))
print(xs)

# for-in
sum = 0
for v in xs do
    sum = sum + v
end
print(sum)

# slice
print(slice(xs, 1, 3))

# concat
a = [1, 2]
b = [3, 4]
print(a .. b)
print(append(a, b))
