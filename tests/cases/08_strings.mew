s = "hello"
print(len(s))
print(upper(s))
print(lower("ABC"))
print(s .. " world")
print(s[0])
print(s[-1])
print(slice(s, 1, 4))
print(find("abcdef", "cd"))
print(find("abcdef", "xx"))
print(replace("foobarfoo", "foo", "X"))
parts = split("a,b,c,d", ",")
print(parts)
print(join(parts, "-"))
# numeric compare of strings
print("abc" < "abd")
print("abc" == "abc")
print(str(42))
print(num("3.5"))
print(num("bad"))
