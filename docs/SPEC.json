{
  "name": "mew",
  "version": "1.0",
  "filetype": ".mew",
  "description": "tiny pocket scripting language, tree walking interpreter in ANSI C99",

  "types": ["nil", "bool", "number", "string", "list", "map", "fn"],

  "keywords": [
    "if", "then", "else", "end",
    "while", "do", "for", "to", "in",
    "fn", "return", "break",
    "and", "or", "not",
    "true", "false", "nil"
  ],

  "comment": "# to end of line (only form)",
  "number":  "float64 literal, regex: \\d+(\\.\\d+)?([eE][+-]?\\d+)? (unary minus is a separate operator)",
  "string":  "double quoted. escapes: \\n \\t \\r \\\" \\\\ \\0",
  "identifier": "[A-Za-z_][A-Za-z0-9_]*",

  "operators": {
    "arith":   ["+", "-", "*", "/", "%"],
    "concat":  "..",
    "compare": ["==", "!=", "<", ">", "<=", ">="],
    "logic":   ["and", "or", "not"],
    "index":   ["x[k]", "x.k"],
    "assign":  "=",
    "call":    "f(args)"
  },

  "precedence_low_to_high": [
    "or",
    "and",
    "not",
    "compare",
    "+ - ..",
    "* / %",
    "unary -",
    "postfix [] . ()"
  ],

  "truthy":   "every value is truthy except false and nil; 0 and empty string are truthy",
  "equality": "strict by type. nil==nil, bool by value, number by ==, string by bytes, list/map/fn by identity",
  "scope":    "assignment creates a local in the enclosing function if the name is not bound above. lookup walks scopes outward to globals. blocks do not create scope, functions do.",
  "errors":   "all errors abort the program with a message (file:line:message). the builtin error(msg) and assert(cond, msg) trigger errors from user code.",
  "recursion_limit": 512,

  "grammar_ebnf": [
    "program     := stmt*",
    "stmt        := assign | if | while | for_to | for_in | fn_decl | return | break | expr_stmt",
    "assign      := lvalue '=' expr",
    "lvalue      := ident | postfix_with_index_or_dot",
    "if          := 'if' expr 'then' stmt* ('else' stmt*)? 'end'",
    "while       := 'while' expr 'do' stmt* 'end'",
    "for_to      := 'for' ident '=' expr 'to' expr 'do' stmt* 'end'",
    "for_in      := 'for' ident 'in' expr 'do' stmt* 'end'",
    "fn_decl     := 'fn' ident '(' params? ')' stmt* 'end'",
    "return      := 'return' expr?",
    "break       := 'break'",
    "expr_stmt   := expr",
    "expr        := or_expr",
    "or_expr     := and_expr ('or' and_expr)*",
    "and_expr    := not_expr ('and' not_expr)*",
    "not_expr    := 'not' not_expr | cmp_expr",
    "cmp_expr    := sum (('=='|'!='|'<'|'>'|'<='|'>=') sum)*",
    "sum         := mul (('+'|'-'|'..') mul)*",
    "mul         := unary (('*'|'/'|'%') unary)*",
    "unary       := '-' unary | postfix",
    "postfix     := atom ('[' expr ']' | '.' ident | '(' args? ')')*",
    "atom        := number | string | 'true' | 'false' | 'nil' | ident | '(' expr ')' | list_lit | map_lit | fn_lit",
    "list_lit    := '[' (expr (',' expr)*)? ']'",
    "map_lit     := '{' (string ':' expr (',' string ':' expr)*)? '}'",
    "fn_lit      := 'fn' '(' params? ')' stmt* 'end'",
    "params      := ident (',' ident)*",
    "args        := expr (',' expr)*"
  ],

  "builtins": {
    "print":        "(...) -> nil   (space separated, trailing newline)",
    "write":        "(...) -> nil   (no separator, no newline)",
    "repr":         "(x) -> string  (quoted, round-trippable form)",
    "read":         "() -> string|nil  (one line, nil on EOF)",
    "len":          "(x: string|list|map) -> number",
    "type":         "(x) -> string  ('nil','bool','number','string','list','map','fn')",
    "str":          "(x) -> string",
    "num":          "(x) -> number|nil",
    "upper":        "(s) -> string",
    "lower":        "(s) -> string",
    "trim":         "(s) -> string",
    "repeat":       "(s, n) -> string",
    "starts_with":  "(s, p) -> bool",
    "ends_with":    "(s, p) -> bool",
    "contains":     "(s|list|map, needle) -> bool",
    "split":        "(s, sep) -> list<string>",
    "join":         "(list<string>, sep) -> string",
    "find":         "(s, sub) -> number  (-1 if not found)",
    "slice":        "(x: string|list, i, j) -> same type  (half open [i,j), supports negatives)",
    "replace":      "(s, a, b) -> string",
    "push":         "(list, x) -> nil",
    "pop":          "(list) -> any  (last element, removed, error if empty)",
    "append":       "(a, b) -> list|string  (non-mutating concat)",
    "reverse":      "(list|string) -> same type",
    "sort":         "(list [, cmp_fn]) -> list  (stable, ascending by default)",
    "keys":         "(map) -> list<string>  (sorted)",
    "values":       "(map) -> list  (in key order)",
    "has":          "(map, k) -> bool",
    "del":          "(map, k) -> nil",
    "read_file":    "(path) -> string|nil",
    "write_file":   "(path, data) -> bool",
    "lines":        "(path) -> list<string>|nil",
    "args":         "() -> list<string>  (cmdline args passed to the script)",
    "exit":         "(code) -> never",
    "getenv":       "(name) -> string|nil",
    "clock":        "() -> number  (cpu seconds since program start)",
    "time":         "() -> number  (unix time)",
    "sleep":        "(sec) -> nil",
    "abs":          "(x) -> number",
    "min":          "(a, b) -> number",
    "max":          "(a, b) -> number",
    "floor":        "(x) -> number",
    "ceil":         "(x) -> number",
    "round":        "(x) -> number",
    "sqrt":         "(x) -> number",
    "pow":          "(x, y) -> number",
    "rand":         "() -> number in [0,1)   or (n) -> integer in [0,n)",
    "seed":         "(n) -> nil",
    "error":        "(msg) -> never  (aborts with msg)",
    "assert":       "(cond [, msg]) -> nil  (aborts if cond is falsy)",
    "load":         "(path) -> bool  (parses and runs file in the global scope; returns false if cannot open)",
    "chr":          "(n) -> string  (one byte; n in 0..255)",
    "ord":          "(s) -> number  (first byte of s as 0..255)",
    "format":       "(fmt, ...) -> string  (%s %d %x %f, width, precision, '-' and '0' flags)"
  },

  "mapping_from_other_languages": {
    "python": {
      "print(x)":            "print(x)",
      "input()":             "read()",
      "len(x)":              "len(x)",
      "str(x)":              "str(x)",
      "int(s)":              "num(s)",
      "float(s)":            "num(s)",
      "s.upper()":           "upper(s)",
      "s.lower()":           "lower(s)",
      "s.strip()":           "trim(s)",
      "s.startswith(p)":     "starts_with(s, p)",
      "s.endswith(p)":       "ends_with(s, p)",
      "sub in s":            "contains(s, sub)",
      "s.split(sep)":        "split(s, sep)",
      "sep.join(lst)":       "join(lst, sep)",
      "s.replace(a, b)":     "replace(s, a, b)",
      "a + b (strings)":     "a .. b",
      "lst + lst":           "l1 .. l2",
      "for i in range(n)":   "for i = 0 to n-1 do ... end",
      "for x in xs":         "for x in xs do ... end",
      "if a == b":           "if a == b then ... end",
      "elif":                "nested 'if ... else if ... end end' (not a single keyword)",
      "def f(a, b):":        "fn f(a, b) ... end",
      "return x":            "return x",
      "lambda x: x*x":       "fn(x) return x*x end",
      "dict[k]":             "m[k] or m.k",
      "k in dict":           "has(m, k)",
      "dict.keys()":         "keys(m)",
      "dict.values()":       "values(m)",
      "sorted(lst)":         "sort(lst)",
      "sorted(lst, key=f)":  "sort(lst, fn(a,b) return f(a) - f(b) end)",
      "open(p).read()":      "read_file(p)",
      "open(p).readlines()": "lines(p)",
      "open(p,'w').write(s)":"write_file(p, s)",
      "math.sqrt(x)":        "sqrt(x)",
      "math.pow(x, y)":      "pow(x, y)",
      "abs(x)":              "abs(x)",
      "min(a, b)":           "min(a, b)",
      "raise Exception(m)":  "error(m)",
      "assert cond, msg":    "assert(cond, msg)",
      "try/except":          "not supported; check return values",
      "chr(n)":              "chr(n)",
      "ord(c)":              "ord(c)",
      "'%s is %d' % (s,n)":  "format(\"%s is %d\", s, n)",
      "f'{x:.2f}'":          "format(\"%.2f\", x)"
    },
    "c": {
      "printf(\"%d\\n\", x)": "print(x)",
      "printf(\"%s\", s)":    "write(s)",
      "scanf":                "read()",
      "strlen(s)":            "len(s)",
      "strcmp(a,b)==0":       "a == b",
      "strcmp(a,b)<0":        "a < b",
      "atoi(s) / atof(s)":    "num(s)",
      "for(i=0;i<n;i++)":     "for i = 0 to n-1 do ... end",
      "while(c){...}":        "while c do ... end",
      "if(c){...}else{...}":  "if c then ... else ... end",
      "fopen/fread":          "read_file(path)",
      "fopen/fwrite":         "write_file(path, data)",
      "pointers / struct":    "not supported; use map for aggregates",
      "malloc/free":          "automatic via gc"
    },
    "shell": {
      "echo x":               "print(\"x\")",
      "read x":               "x = read()",
      "cat file":             "write(read_file(\"file\"))",
      "for f in list; do":    "for f in list do",
      "if [ \"$a\" = \"$b\" ]":"if a == b then",
      "$1 $2":                "args()[0]  args()[1]",
      "export FOO":           "set env is not supported; only getenv",
      "source file":          "load(\"file\")"
    }
  },

  "translation_rules": [
    "Only use the 17 keywords listed. Do not invent new ones.",
    "Every block is closed by 'end'. Never braces, never indentation.",
    "Use '..' for concatenation (string or list). Use '+' only for numbers.",
    "Assignment is '='. Equality is '=='.",
    "Exceptions do not exist. Report errors by returning nil or calling error(msg).",
    "Classes do not exist. Group state in a map and pass it to functions.",
    "for-to is inclusive on both ends and ascending only. if from > to, the body does not run. for descending iteration use a while loop.",
    "Map keys in literals must be string literals. For dynamic keys use m[k] assignment.",
    "Comments are '#' only, never '//' or '/* */'.",
    "No increment/decrement operators. Use 'i = i + 1'.",
    "No ternary operator. Use 'if ... then ... else ... end' or 'cond and a or b'.",
    "'break' must be inside a while/for loop. 'return' must be inside a function. Both are syntax errors at the top level."
  ],

  "example_programs": [
    {
      "name": "filename compare",
      "mew": "if lower(a) == lower(b) then print(\"same\") end"
    },
    {
      "name": "word count",
      "mew": "c = {}\nfor w in split(lower(text), \" \") do\n  if has(c, w) then c[w] = c[w]+1 else c[w] = 1 end\nend"
    },
    {
      "name": "fibonacci",
      "mew": "fn fib(n)\n  if n < 2 then return n end\n  return fib(n-1) + fib(n-2)\nend"
    }
  ]
}
