# the break statement must not leak out of a function call into a surrounding
# loop in the caller. historically call_value saved g_ret but not g_break,
# so a `break` inside a function-local loop could escape into the caller's
# loop too. now g_break is also saved/restored so the function's own break
# stays scoped to its own loop. (audit pass 2: a top-level `break` outside
# any loop is now a parse error, so this test exercises a function-local
# loop instead.)
fn loops_then_returns()
    for i = 1 to 1 do
        break
    end
    return "inner exited cleanly"
end

count = 0
for j = 1 to 5 do
    print(loops_then_returns())
    count = count + 1
end
print(count)

# matching sanity check: break still works when used properly inside a
# function-local loop.
fn inner_break()
    total = 0
    for i = 1 to 10 do
        if i > 3 then break end
        total = total + i
    end
    return total
end
print(inner_break())
